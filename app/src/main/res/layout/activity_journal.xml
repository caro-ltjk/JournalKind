<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grid_pattern">

    <!-- Encabezado -->
    <include
        android:id="@+id/headerView"
        layout="@layout/header_journal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Volver -->
    <LinearLayout
        android:id="@+id/topBarJournal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerView">

        <Button
            android:id="@+id/btnVolverHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C85272" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi Journal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5A3A40"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Hoja del Diario -->
    <FrameLayout
        android:id="@+id/frameJournalPage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:background="#FCF9F9"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBarJournal"
        app:layout_constraintBottom_toTopOf="@id/panelHerramientas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoja en blanco \nPresiona el botón de editar para empezar a plasmar tus ideas."
            android:textColor="#8A6B72"
            android:textSize="14sp"
            android:layout_gravity="center"
            android:gravity="center"/>
    </FrameLayout>

    <!-- Editar -->
    <LinearLayout
        android:id="@+id/panelHerramientas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFD8E4"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar hoja"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C85272"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>