<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grid_pattern">

    <!-- Encabezado -->
    <include
        android:id="@+id/headerView"
        layout="@layout/header_journal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Volver -->
    <LinearLayout
        android:id="@+id/topBarFavorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerView">

        <Button
            android:id="@+id/btnVolverHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C85272" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favoritos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5A3A40"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Favoritos -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aquí se visualizan tus diseños favoritos ♡"
        android:textSize="14sp"
        android:textColor="#8A6B72"
        app:layout_constraintTop_toBottomOf="@id/topBarFavorites"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>